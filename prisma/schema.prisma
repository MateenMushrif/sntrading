datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum SectionType {
  hero
  trust_strip
  search_categories
  brand_strip
  featured_products
  wholesale_cta
}

// ------------------------------------------------------
// PRODUCTS
// ------------------------------------------------------

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String?
  fullDescription  String?
  status           ProductStatus @default(ACTIVE)
  isFeatured       Boolean       @default(false)
  isLatest         Boolean       @default(false)
  displayOrder     Int           @default(0)

  // SEO Metadata
  metaTitle        String?
  metaDescription  String?

  // Category & Brand Relations
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?        @relation(fields: [brandId], references: [id])

  // Thumbnail Image Relation
  thumbnailImageId String?       @unique
  thumbnailImage   ProductImage? @relation("ProductThumbnail", fields: [thumbnailImageId], references: [id], onDelete: SetNull)

  // Child Relations
  images           ProductImage[]         @relation("ProductGallery")
  variants         ProductVariant[]
  specifications   ProductSpecification[]
  features         ProductFeature[]
  applications     ProductApplication[]
  tags             ProductTagRelation[]
  badges           ProductBadgeRelation[]

  relatedFrom      RelatedProduct[]       @relation("PrimaryProduct")
  relatedTo        RelatedProduct[]       @relation("RelatedProduct")

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([status, createdAt])
  @@index([status, isFeatured])
  @@index([status, isLatest])
  @@index([displayOrder])
  @@index([name])
}

// ------------------------------------------------------
// PRODUCT IMAGES
// ------------------------------------------------------

model ProductImage {
  id                 String   @id @default(cuid())
  productId          String?
  product            Product? @relation("ProductGallery", fields: [productId], references: [id], onDelete: Cascade)

  cloudinaryPublicId String
  secureUrl          String
  altText            String?
  width              Int?
  height             Int?
  format             String?
  isThumbnail        Boolean  @default(false)
  displayOrder       Int      @default(0)

  thumbnailForProduct Product? @relation("ProductThumbnail")
  variants           ProductVariant[]

  createdAt          DateTime @default(now())

  @@index([productId])
  @@index([productId, displayOrder])
}

// ------------------------------------------------------
// CATEGORIES & BRANDS
// ------------------------------------------------------

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?   
  isFeatured   Boolean   @default(false)
  displayOrder Int       @default(0)

  products     Product[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
  @@index([name])
  @@index([isFeatured])
  @@index([displayOrder])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?   
  websiteUrl  String?   
  description String?
  isFeatured  Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([name])
  @@index([isFeatured])
}

// ------------------------------------------------------
// PRODUCT VARIANTS & DETAILS
// ------------------------------------------------------

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  name         String   
  weightOrSize String   
  sku          String?  @unique
  displayOrder Int      @default(0)

  imageId      String?
  image        ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
  @@index([productId, displayOrder])
}

model ProductSpecification {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  label        String   
  value        String   
  displayOrder Int      @default(0)

  @@index([productId])
  @@index([productId, displayOrder])
}

model ProductFeature {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  feature      String   
  displayOrder Int      @default(0)

  @@index([productId])
  @@index([productId, displayOrder])
}

model ProductApplication {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  application  String   
  displayOrder Int      @default(0)

  @@index([productId])
  @@index([productId, displayOrder])
}

// ------------------------------------------------------
// TAGS & BADGES
// ------------------------------------------------------

model Tag {
  id       String               @id @default(cuid())
  name     String
  slug     String               @unique

  products ProductTagRelation[]
}

model ProductTagRelation {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Badge {
  id       String                 @id @default(cuid())
  name     String                 
  color    String?                
  icon     String?                
  priority Int                    @default(0)

  products ProductBadgeRelation[]
}

model ProductBadgeRelation {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([productId, badgeId])
  @@index([badgeId])
}

// ------------------------------------------------------
// RELATED PRODUCTS
// ------------------------------------------------------

model RelatedProduct {
  productId        String
  product          Product @relation("PrimaryProduct", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([relatedProductId])
}

// ------------------------------------------------------
// BAKERIES AND CUSTOMERS
// ------------------------------------------------------

model Bakery {
  id         String     @id @default(cuid())
  name       String
  logo       String?
  ownerName  String
  gstin      String?
  address    String
  city       String
  state      String     @default("Karnataka")
  pinCode    String
  country    String     @default("India")
  phone      String
  email      String?
  website    String?
  notes      String?
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customers  Customer[]
}

model Customer {
  id                 String   @id @default(cuid())
  fullName           String
  mobilePrimary      String
  mobileAlternate    String?
  email              String?
  profilePhoto       String?
  designation        String   @default("Buyer")
  gstin              String?
  notes              String?
  status             String   @default("approved")
  dateJoined         DateTime @default(now())
  lastContacted      DateTime @default(now())
  lastInquiry        String?
  totalInquiries     Int      @default(0)
  totalQuotations    Int      @default(0)
  productsInterested String[] @default([])
  isArchived         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bakeryId           String
  bakery             Bakery   @relation(fields: [bakeryId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// STAFF AND ROLES
// ------------------------------------------------------

model Staff {
  id             String          @id @default(cuid())
  name           String
  username       String          @unique
  passwordHash   String
  email          String          @unique
  phone          String
  department     String?
  designation    String?
  employeeId     String?         @unique
  profilePhoto   String?
  status         String          @default("active")
  lastLogin      DateTime?
  notes          String?
  isArchived     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  roleId         String
  role           Role            @relation(fields: [roleId], references: [id])
  trustedDevices TrustedDevice[]
  activityLogs   ActivityLog[]
}

model Role {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String
  permissions     String[] @default([])
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staffMembers    Staff[]
}

// ------------------------------------------------------
// TRUSTED DEVICES & ACTIVITY LOGS
// ------------------------------------------------------

model TrustedDevice {
  id                String   @id @default(cuid())
  deviceName        String
  deviceId          String   @unique
  token             String   @unique
  deviceFingerprint String?
  os                String?  @default("Windows 11")
  deviceType        String?  @default("Desktop")
  ipAddress         String?  
  status            String   @default("authorized")
  firstRegistered   DateTime @default(now())
  lastUsed          DateTime @default(now())
  
  staffId           String?
  staff             Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([status])
}

model ActivityLog {
  id               String   @id @default(cuid())
  action           String   
  target           String?  
  ipAddress        String?
  authorizedDevice String?
  createdAt        DateTime @default(now())

  staffId          String?
  staff            Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
}

// ------------------------------------------------------
// STOREFRONT LAYOUT & HERO CAROUSEL PERSISTENCE
// ------------------------------------------------------

model HeroSlide {
  id           String   @id @default(cuid())
  badge        String?
  title        String
  subtitle     String
  ctaText      String?
  actionType   String   @default("products")
  actionValue  String?
  bgType       String   @default("gradient")
  bgValue      String?  
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

model StorefrontSection {
  id           String      @id @default(cuid())
  sectionKey   String      @unique // "sec-hero" | "sec-trust" | "sec-search-categories" | "sec-brands" | "sec-featured-products" | "sec-wholesale-cta"
  type         String      // "hero" | "trust_strip" | "search_categories" | "brand_strip" | "featured_products" | "wholesale_cta"
  title        String
  enabled      Boolean     @default(true)
  columns      Int         @default(6) // 2 | 3 | 4 | 6
  displayOrder Int         @default(0)
  updatedAt    DateTime    @updatedAt

  @@index([displayOrder])
}